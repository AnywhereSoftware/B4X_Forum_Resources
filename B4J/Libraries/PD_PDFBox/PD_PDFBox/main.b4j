Version=10.5
@EndOfDesignText@
#Region Project Attributes 
	#MainFormWidth: 600
	#MainFormHeight: 600 
	#MergeLibraries:  true
	
#End Region

Sub Process_Globals
	Private fx As JFX
	Private MainForm As Form
	Private xui As XUI 
	Private Button1 As B4XView
	
End Sub

Sub AppStart (Form1 As Form, Args() As String)
	MainForm = Form1
	MainForm.RootPane.LoadLayout("Layout1")
	MainForm.Show
	
	
	creatPDF_rtl_Languages

	creatPDF_ltr_Languages
End Sub

Sub creatPDF_rtl_Languages
	
	Dim pdf As PD_PDFBox
	pdf.Initialize
	'pdf.SetFont("tahoma")
	pdf.SetCustomFont(File.Combine(File.DirApp,"Vazir-Light.ttf") , File.Combine(File.DirApp,"Vazir-Bold.ttf"))
	pdf.SetPageNumbering(True, "{page} of {total}", 10, "#666666", "CENTER", 2)
	pdf.SetFooterReserve(4)
	pdf.SetContinuationTop(3)
  
	pdf.AddPage("A4", False)

	pdf.AddImage(File.Combine(File.DirApp,"logo.png"), 85, 0, 15, 10)
	
	
	Dim y As Double = 2  ' ⭐ شروع از 2% بالا

	' عنوان
	y = pdf.AddText("گزارش فروش ماهانه", 10, y, 80, 5, 18, "#333333", "CENTER", "MIDDLE", True)
	' y = 20

	' فاصله
	y = y + 2
    ' y = 20 + 2
   
   
	y = pdf.AddRectangle(10,y,80,10,"#333333","#BFBFBF",1)
	y = y + 1

	' خط جداکننده
	y = pdf.AddLine(10, y, 90, y, "#CCCCCC", 1)
	' y الان = 8 (چون خط افقیه، y1=y2)

	' فاصله
	y = y + 2
	' y الان = 20

	' پاراگراف طولانی (ممکنه چند صفحه بشه)
	Dim longText As String = ""
	For i = 1 To 150
		longText = longText & "این یک متن آزمایشی بلند است. "
	Next
	y = pdf.AddParagraph(longText, 10, y, 80, 50, 11, 0, "#000000", "RIGHT", "TOP", False)
	' y الان = موقعیت بعد از آخرین خط پاراگراف

	' فاصله
	y = y + 2

	' جدول
	Dim headers() As String = Array As String("ردیف", "نام", "مقدار")
	Dim colWidths() As Double = Array As Double(15, 50, 35)

	pdf.CreateTable(headers, colWidths, 10, y, 80, 3, 10, _
    "#4472C4", "#AAAAAA", "#000000", "RIGHT", "MIDDLE")

	For i = 1 To 50
		pdf.AddRow(Array As String(i, "محصول " & i, 1000 * i))
	Next

	y = pdf.EndTable
	' y الان = موقعیت بعد از آخرین سطر جدول

	' فاصله
	y = y + 2

	' جمع کل
	y = pdf.AddText("جمع کل: ۱,۲۷۵,۰۰۰,۰۰۰ تومان", 10, y, 80, 4, 14, "#222222", "RIGHT", "MIDDLE", True)

    Dim targetPath As String = File.Combine(File.DirApp,"test.pdf")
	Dim success As Boolean = pdf.Save(targetPath)
	Log("PDF created success :  " & success )
	Log("PDF created with " & pdf.GetPageCount & " pages")
	
	
'	Dim ok As Boolean = pdf.PrintPDF
'	If ok Then Log("چاپ موفق") Else Log("لغو یا خطا")
'	
	
	pdf.Close
	
	Sleep(1000)
	fx.ShowExternalDocument(File.GetUri(File.DirApp,"test.pdf"))
	
	pdf.PrintFile(targetPath)
End Sub

Sub creatPDF_ltr_Languages
	
    Dim pdf As PD_PDFBox
    pdf.Initialize
    
    ' Use system font (Windows)
    pdf.SetFont("Arial")
    
    ' Settings
    pdf.SetPageNumbering(True, "Page {page} of {total}", 9, "#666666", "CENTER", 3)
    pdf.SetFooterReserve(5)
    pdf.SetContinuationTop(3)
    
    pdf.AddPage("A4", False)
    
    Dim y As Double = 3
    
    ' Company name (left aligned)
    y = pdf.AddText("ACME Corporation", 5, y, 50, 6, 20, "#2C3E50", "LEFT", "TOP", True)
    
    ' Invoice number (right aligned)
    pdf.AddText("Invoice #INV-2025-001", 55, 3, 40, 5, 11, "#555555", "RIGHT", "TOP", False)
    pdf.AddText("Date: 2025-01-15", 55, 7, 40, 5, 11, "#555555", "RIGHT", "TOP", False)
    
    y = y + 3
    
    ' Divider line
    y = pdf.AddLine(5, y, 95, y, "#2C3E50", 1.5)
    y = y + 3
    
    ' Bill To section
    y = pdf.AddText("Bill To:", 5, y, 30, 5, 11, "#000000", "LEFT", "TOP", True)
    y = pdf.AddText("John Smith", 5, y, 50, 5, 11, "#000000", "LEFT", "TOP", False)
    y = pdf.AddText("123 Main Street", 5, y, 50, 5, 11, "#000000", "LEFT", "TOP", False)
    y = pdf.AddText("New York, NY 10001", 5, y, 50, 5, 11, "#000000", "LEFT", "TOP", False)
    y = pdf.AddText("USA", 5, y, 50, 5, 11, "#000000", "LEFT", "TOP", False)
    
    y = y + 3
    
    ' Items table
    Dim headers() As String = Array As String("No.", "Description", "Qty", "Price", "Total")
    Dim colWidths() As Double = Array As Double(8, 50, 12, 15, 15)
    
    pdf.CreateTable(headers, colWidths, _
        5, y, 90, _
        2.5, 10, _
        "#2C3E50", "#CCCCCC", "#000000", _
        "LEFT", "MIDDLE")
    
    pdf.AddRow(Array As String("1", "Website Development", "1", "$2,500", "$2,500"))
    pdf.AddRow(Array As String("2", "Logo Design", "1", "$500", "$500"))
    pdf.AddRow(Array As String("3", "Hosting (12 months)", "1", "$120", "$120"))
    pdf.AddRow(Array As String("4", "SSL Certificate", "1", "$80", "$80"))
    
    y = pdf.EndTable
    y = y + 2
    
    ' Totals
    pdf.AddText("Subtotal:", 60, y, 20, 4, 11, "#000000", "RIGHT", "MIDDLE", False)
    pdf.AddText("$3,200.00", 80, y, 15, 4, 11, "#000000", "RIGHT", "MIDDLE", False)
    y = y + 4
    
    pdf.AddText("Tax (10%):", 60, y, 20, 4, 11, "#000000", "RIGHT", "MIDDLE", False)
    pdf.AddText("$320.00", 80, y, 15, 4, 11, "#000000", "RIGHT", "MIDDLE", False)
    y = y + 4
    
    y = pdf.AddLine(60, y, 95, y, "#2C3E50", 1)
    y = y + 1
    
    pdf.AddText("TOTAL:", 60, y, 20, 5, 13, "#2C3E50", "RIGHT", "MIDDLE", True)
    pdf.AddText("$3,520.00", 80, y, 15, 5, 13, "#2C3E50", "RIGHT", "MIDDLE", True)
    
    ' Save
    Dim path As String = File.Combine(File.DirApp,"invoice.pdf")
    If pdf.Save(path) Then
        Log("Invoice saved: " & path)
    End If
    pdf.Close
	
	
	Sleep(1000)
	fx.ShowExternalDocument(File.GetUri(File.DirApp,"invoice.pdf"))

End Sub
