Build1=Default,B4RDev
Group=Default Group
Library1=rcore
Library2=ronewireex
NumberOfFiles=0
NumberOfLibraries=2
NumberOfModules=0
Version=4
@EndOfDesignText@
#Region Project Header
'==============================================
' Project:	rOneWire
' Brief:	Basic example timer reading temperature regular intervals from a DS1820b
' Date:		2026-08-26
' Author: 	Robert W.B. Linn
' License:	MIT — see LICENSE file.
' Hardware:	ESP-WROOM-32, Arduino UNO R4. Ensure to reset after upload.
' Software:	B4R 4.00 (64 bit), IDE ESP32 Dev Module
'			Arduino Board Manager ESP32 3.3.11.
'			Arduino OneWire library 2.3.8
' Wiring:	ESP32 D4 = DS1820b Signal
'			ESP32 3V3 = DS1820b VCC
'			ESP32 GND = DS1820b GND
'			Physical 4.7 kOhm pull-up resistor is installed linking your VCC and Data pin lines.
' Log:
'[AppStart]rOneWireEx Timer DS1820b v20260824
'[AppStart] Device found > timer started
'[TimerWireBus] 5495 t=18.3750
'[TimerWireBus] 10495 t=18.3750
'[TimerWireBus] 15495 t=18.3750
'[TimerWireBus] 20495 t=18.5000
'[TimerWireBus] 25495 t=20.3750
'[TimerWireBus] 30495 t=22.7500
'==============================================
#End Region

#Region Project Attributes
	#AutoFlushLogs: True
	#CheckArrayBounds: True
	#StackBufferSize: 600
#End Region
'Ctrl+Click to open the C code folder: ide://run?File=%WINDIR%\System32\explorer.exe&Args=%PROJECT%\Objects\Src

Sub Process_Globals
	Private VERSION As String = "rOneWireEx Timer DS1820b v20260826"

	' Communication
	Public Serial1 As Serial
	
	' WireBus
	Private WireBus As OneWireEx
	Private BUS_PIN As Byte = 4
	Private Address(8) As Byte
	Private RESOLUTION As Int = WireBus.RESOLUTION_12	' 9=0.5, 10=025, 11=0.125, 12=0.0625

	' Timer
	Private TimerWireBus As Timer
	Private TIMER_INTERVALL As ULong = 5000
	
	'Helper
	' Private bc As ByteConverter
End Sub

Private Sub AppStart
	Serial1.Initialize(115200)
	Log(CRLF, "[AppStart]", VERSION)

	' Init timer
	TimerWireBus.Initialize("TimerWireBus_Tick", TIMER_INTERVALL)
	TimerWireBus.Enabled = False

	' Init onewire
	WireBus.Initialize(BUS_PIN)
	If WireBus.ReadAddress(Address) Then
		WireBus.SetResolution(Address, RESOLUTION)
		TimerWireBus.Enabled = True
		Log("[AppStart] Device found > timer started")
	Else
		Log("[AppStart] No device found connected to pin ", BUS_PIN)		
	End If
End Sub

Private Sub TimerWireBus_Tick
	Dim t As Float = WireBus.ReadTemperature(Address)
	Log("[TimerWireBus] ", Millis, " t=", t)
End Sub
