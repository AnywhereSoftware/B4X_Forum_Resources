'		Case 0x28: Return "DS18B20"
'		Case 0x10: Return "DS18S20"
'		Case 0x22: Return "DS1822"
'		Case 0x3B: Return "MAX31820"
'		Case 0x01: Return "iButton Key"
'		Case 0x24: Return "EEPROM Storage"
'		Case Else: Return "Unknown Device"
'	End Select
'End Sub
