Build1=Default,B4RDev
Group=Default Group
Library1=rcore
Library2=rarduinoledmatrix
NumberOfFiles=0
NumberOfLibraries=2
NumberOfModules=0
Version=4
@EndOfDesignText@
#Region Project Header
'==============================================
' Project:	rArduinoLEDMatrix
' Brief:	Basic example to test various methods.
